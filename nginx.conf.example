server {
    listen 80;
    server_name demo.example.com;
    root /var/www/ringout_landing;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(css|js|svg)$ {
        expires 1h;
        try_files $uri =404;
    }
}
